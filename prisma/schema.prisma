generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ExpenseType {
  pessoal
  empresa
  cliente
}

enum ExpenseStatus {
  processado
  rever
}

enum CategoryScope {
  pessoal
  empresa
  cliente
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  categories       Category[]
  clients          Client[]
  expenses         Expense[]
  profile          UserProfile?
  timesheetEntries TimesheetEntry[]
}

model UserProfile {
  userId          String  @id
  user            User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  fromName        String  @default("")
  fromAddress     String  @default("")
  fromEmail       String  @default("")
  fromPhone       String  @default("")
  projectDirector String  @default("")
  bankAccountName String  @default("")
  bankName        String  @default("")
  bankAccountNo   String  @default("")
  bankIban        String  @default("")
  bankSwift       String  @default("")
  bankCurrency    String  @default("")
  extraBanks      Json    @default("[]")
  activeClientId  String?
  activeClient    Client? @relation("ActiveProject", fields: [activeClientId], references: [id], onDelete: SetNull)
}

model Client {
  id              String        @id @default(cuid())
  userId          String?
  user            User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String
  projectName     String        @default("")
  startDate       DateTime?     @db.Date
  projectDirector String?
  address         String?
  email           String?
  phone           String?
  fromName        String        @default("")
  fromAddress     String        @default("")
  fromEmail       String        @default("")
  fromPhone       String        @default("")
  bankAccountName String        @default("")
  bankName        String        @default("")
  bankAccountNo   String        @default("")
  bankIban        String        @default("")
  bankSwift       String        @default("")
  bankCurrency    String        @default("")
  extraBanks      Json          @default("[]")
  activeForProfiles UserProfile[] @relation("ActiveProject")

  @@unique([userId, name])
  @@index([userId])
}

model TimesheetEntry {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientName   String
  workDate     DateTime @db.Date
  startTime    String   @default("09:00")
  endTime      String   @default("17:00")
  breakMinutes Int      @default(0)
  days         Decimal  @db.Decimal(5, 2)
  rate         Decimal  @db.Decimal(12, 2)
  currency     String
  description  String?
  createdAt    DateTime @default(now())

  @@index([userId, clientName])
}

model Category {
  id     String        @id @default(cuid())
  userId String?
  user   User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  scope  CategoryScope
  name   String

  @@unique([userId, scope, name])
  @@index([userId])
}

model Expense {
  code            String        @id
  userId          String?
  user            User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  merchant        String
  amount          Decimal       @db.Decimal(12, 2)
  currency        String
  date            DateTime      @db.Date
  type            ExpenseType
  category        String
  clientName      String?
  status          ExpenseStatus
  receiptImageUrl String?
  comment         String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([userId])
}
